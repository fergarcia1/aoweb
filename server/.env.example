# Optional: PostgreSQL persistence
# If omitted, server uses in-memory repository.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/aoweb

# Optional server port
PORT=3001

# Auth
# En produccion conviene true para que solo entren cuentas registradas.
AUTH_REQUIRED=false
# Cambiar siempre en produccion.
AUTH_TOKEN_SECRET=change-me

# CORS para login/register HTTP.
# Local: http://localhost:5173
# Vercel: https://tu-aoweb.vercel.app
CORS_ORIGIN=http://localhost:5173

# Rate Limiting & Anti-Spam
RATE_LIMIT_MAX_CONNECTIONS_PER_IP=3
RATE_LIMIT_MAX_ACTIONS_PER_SECOND=20
RATE_LIMIT_TEMP_BAN_MS=300000

# Auth hardening
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_LOGIN_MAX_ATTEMPTS_PER_WINDOW=10
AUTH_REGISTER_MAX_ATTEMPTS_PER_WINDOW=5
AUTH_REFRESH_MAX_ATTEMPTS_PER_WINDOW=30
AUTH_LOGOUT_MAX_ATTEMPTS_PER_WINDOW=30
AUTH_FAILED_LOGIN_LIMIT=5
AUTH_FAILED_LOGIN_WINDOW_MS=900000
AUTH_FAILED_LOGIN_LOCK_MS=900000
AUTH_REFRESH_TOKEN_TTL_MS=2592000000
AUTH_MAX_SESSIONS_PER_ACCOUNT=5
# En produccion se activa automaticamente por NODE_ENV=production.
# Forzar solo si hace falta.
# AUTH_COOKIE_SECURE=true

# WebSocket protocol hardening
WS_JOIN_TIMEOUT_MS=10000
WS_MAX_PAYLOAD_BYTES=16384
WS_MAX_INVALID_MESSAGES_PER_SOCKET=3

# Activar solo si el servidor esta detras de Cloudflare/Nginx/Render
# y se quiere usar CF-Connecting-IP / X-Forwarded-For como IP real.
TRUST_PROXY=false
