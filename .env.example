# URL del servidor WebSocket.
# Local:
# VITE_WS_URL=ws://localhost:3001
# Produccion con frontend en Vercel + server Node externo:
# VITE_WS_URL=wss://tu-aoweb-server.example.com

# Poner VITE_MULTIPLAYER=0 para jugar solo sin intentar conectar
VITE_MULTIPLAYER=1

# Modo gratis/debug: false muestra "Continuar sin cuenta (dev)".
# Alpha con cuentas reales: true.
VITE_AUTH_REQUIRED=false

# Skin inicial del cliente: red | dark | clear
VITE_UI_SKIN=red
